class BankAccount {
  init(balance) {
    this.balance = balance;
  }
  deposit(amount) {
    this.balance = this.balance + amount;
  }
  withdraw(amount) {
    if (amount > this.balance) {
      print "insufficient funds";
      return;
    }
    this.balance = this.balance - amount;
  }
  getBalance() {
    return this.balance;
  }
}

var acct = BankAccount(100);
acct.deposit(50);
print acct.getBalance();
acct.withdraw(30);
print acct.getBalance();
acct.withdraw(200);
print acct.getBalance();
