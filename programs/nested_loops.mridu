var s = 0;
for (var i = 1; i <= 3; i = i + 1) {
  var j = 1;
  while (j <= i) {
    s = s + j;
    j = j + 1;
  }
}
print s;

var t = "";
for (var i = 0; i < 3; i = i + 1) {
  for (var j = 0; j < 3; j = j + 1) {
    t = t + "*";
  }
}
print t;

var prod = 1;
var i = 1;
while (i <= 5) {
  var j = 1;
  while (j <= 2) {
    prod = prod * j;
    j = j + 1;
  }
  i = i + 1;
}
print prod;
