fun fact(n) {
  if (n <= 1) return 1;
  return n * fact(n - 1);
}
print fact(0);
print fact(1);
print fact(5);
print fact(10);

fun sum(n) {
  if (n <= 0) return 0;
  return n + sum(n - 1);
}
print sum(0);
print sum(1);
print sum(10);

fun gcd(a, b) {
  if (b == 0) return a;
  return gcd(b, a - b * (a / b));
}
print gcd(12, 8);
print gcd(100, 35);
print gcd(7, 13);
